{
  "name": "@redbearai/dsh-memoryskills",
  "version": "0.2.2",
  "description": "MemorySkills long-term memory for DeepSeek Harness: sign in with email, paste one sk-mem- key, no MemoryBear tenant setup",
  "icon": "./icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuanmoSuanyangTechnology/MemoryBearDSHPlugin.git",
    "directory": "packages/dsh-memoryskills"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "icon.png",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "memorybear",
    "memoryskills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "pnpm --filter @redbearai/dsh-memory-core run build && tsx scripts/build.ts",
    "typecheck": "pnpm --filter @redbearai/dsh-memory-core run build && tsc -p tsconfig.json",
    "test": "pnpm run build && tsx --test test/api.test.ts test/plugin.test.ts test/client-page.test.ts",
    "dsh": "tsx scripts/run-dsh.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@redbearai/dsh-memory-core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "18.3.27",
    "esbuild": "0.25.12",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
